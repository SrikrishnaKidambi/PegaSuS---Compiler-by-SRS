/*
 * optimizer_sai.c
 * ═══════════════════════════════════════════════════════════════════════════
 * Code Optimisation Module — Sai Krishna
 *
 *   Pass 1 : Algebraic Simplification          (IR     → OPT_IR)
 *   Pass 2 : Copy Propagation                  (OPT_IR refined in-place)
 *   Pass 3 : Induction Variable Elimination    (OPT_IR refined in-place)
 *
 * IR[] is never modified.  OPT_IR[] is the sole output array.
 * ═══════════════════════════════════════════════════════════════════════════
 */

#include "optimizer_sai.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

/* ═══════════════════════════════════════════════════════════════════════════
   OUTPUT ARRAY
   ═══════════════════════════════════════════════════════════════════════════ */
Quad OPT_IR[IR_SIZE];
int  OPT_IR_idx = 0;

/* ═══════════════════════════════════════════════════════════════════════════
   SHARED INTERNAL HELPERS
   ═══════════════════════════════════════════════════════════════════════════ */

/* Return 1 if s is a pure numeric literal */
static int is_numeric(const char *s)
{
    if (!s || !*s) return 0;
    char *end;
    strtod(s, &end);
    return (*end == '\0');
}

/* Return 1 if numeric string s equals integer value v */
static int is_int_val(const char *s, int v)
{
    if (!is_numeric(s)) return 0;
    double d = atof(s);
    return ((int)d == v) && (fabs(d - (int)d) < 1e-9);
}

/*
 * If v >= 2 and is an exact power of two, return log2(v); else -1.
 *   pow2_exp(8) == 3,  pow2_exp(6) == -1
 */
static int pow2_exp(int v)
{
    if (v < 2) return -1;
    int e = 0, x = v;
    while (x > 1) {
        if (x & 1) return -1;
        x >>= 1; ++e;
    }
    return e;
}

/* Build a copy quad  result = src  in *q */
static void make_copy_quad(Quad *q, const char *result, const char *src)
{
    strcpy(q->op,     "=");
    strcpy(q->arg1,   src);
    q->arg2[0] = '\0';
    strcpy(q->result, result);
}

/* Build a binary-op quad  result = a op b  in *q */
static void make_binop_quad(Quad *q,
                            const char *op,
                            const char *a, const char *b,
                            const char *result)
{
    strcpy(q->op,     op);
    strcpy(q->arg1,   a);
    strcpy(q->arg2,   b);
    strcpy(q->result, result);
}

/*
 * Shift OPT_IR[pos..OPT_IR_idx-1] up by 1 to open a slot at pos.
 * Returns 1 on success, 0 if array is full.
 */
static int insert_opt_quad_at(int pos)
{
    if (OPT_IR_idx >= IR_SIZE) return 0;
    memmove(&OPT_IR[pos + 1], &OPT_IR[pos],
            (OPT_IR_idx - pos) * sizeof(Quad));
    ++OPT_IR_idx;
    return 1;
}

/* ═══════════════════════════════════════════════════════════════════════════
   PASS 1 — ALGEBRAIC SIMPLIFICATION
   ═══════════════════════════════════════════════════════════════════════════

   Single forward pass over IR[].  For each quad, the first matching rule
   below supplies a replacement quad that is written to OPT_IR[].
   If no rule matches, the original quad is copied verbatim.
   Eliminated quads are simply not emitted (no NOP needed).

   Rules applied
   ─────────────
   ADDITION (+)
       x + 0  →  = x          (identity)
       0 + x  →  = x          (identity)

   SUBTRACTION (-)
       x - 0  →  = x          (identity)
       x - x  →  = 0          (self-cancellation)

   MULTIPLICATION (*)
       x * 0  →  = 0          (annihilation)
       0 * x  →  = 0
       x * 1  →  = x          (identity)
       1 * x  →  = x
       x * 2  →  x + x        (strength reduction: add is cheaper than mul)
       2 * x  →  x + x
       x * 2^k→  x << k       (k >= 2; strength reduction via shift)
       2^k * x→  x << k

   DIVISION (/)
       x / 1  →  = x          (identity)
       x / x  →  = 1          (self-division; x != 0 assumed)
       x / 2^k→  x >> k       (strength reduction via shift)

   MODULO (%)
       x % 1  →  = 0

   EXPONENTIATION (^)
       x ^ 0  →  = 1
       x ^ 1  →  = x

   LOGICAL NOT (!)  on literal
       ! 0    →  = 1
       ! 1    →  = 0
   ─────────────────────────────────────────────────────────────────────── */
int run_algebraic_simplification(void)
{
    OPT_IR_idx = 0;
    int total  = 0;

    for (int i = 0; i < IR_idx; i++) {
        const Quad *s = &IR[i];
        Quad out;
        memset(&out, 0, sizeof(out));
        int fired = 0;

        /* ── ADDITION ────────────────────────────────────────────────── */
        if (strcmp(s->op, "+") == 0) {
            if (is_int_val(s->arg2, 0))                        /* x + 0 */
                { make_copy_quad(&out, s->result, s->arg1);  fired = 1; }
            else if (is_int_val(s->arg1, 0))                   /* 0 + x */
                { make_copy_quad(&out, s->result, s->arg2);  fired = 1; }
        }

        /* ── SUBTRACTION ─────────────────────────────────────────────── */
        else if (strcmp(s->op, "-") == 0) {
            if (is_int_val(s->arg2, 0))                        /* x - 0 */
                { make_copy_quad(&out, s->result, s->arg1);  fired = 1; }
            else if (s->arg1[0] && strcmp(s->arg1, s->arg2) == 0) /* x - x */
                { make_copy_quad(&out, s->result, "0");       fired = 1; }
        }

        /* ── MULTIPLICATION ──────────────────────────────────────────── */
        else if (strcmp(s->op, "*") == 0) {
            if (is_int_val(s->arg2, 0) || is_int_val(s->arg1, 0))
                { make_copy_quad(&out, s->result, "0");       fired = 1; }
            else if (is_int_val(s->arg2, 1))
                { make_copy_quad(&out, s->result, s->arg1);  fired = 1; }
            else if (is_int_val(s->arg1, 1))
                { make_copy_quad(&out, s->result, s->arg2);  fired = 1; }
            /* x*2 → x+x  (checked BEFORE pow2 so 2 → add, not shift) */
            else if (is_int_val(s->arg2, 2))
                { make_binop_quad(&out, "+", s->arg1, s->arg1, s->result); fired = 1; }
            else if (is_int_val(s->arg1, 2))
                { make_binop_quad(&out, "+", s->arg2, s->arg2, s->result); fired = 1; }
            /* x * 2^k  →  x << k  (k >= 2) */
            else if (is_numeric(s->arg2)) {
                int e = pow2_exp((int)atof(s->arg2));
                if (e >= 2) {
                    char es[12]; sprintf(es, "%d", e);
                    make_binop_quad(&out, "<<", s->arg1, es, s->result);
                    fired = 1;
                }
            }
            else if (is_numeric(s->arg1)) {
                int e = pow2_exp((int)atof(s->arg1));
                if (e >= 2) {
                    char es[12]; sprintf(es, "%d", e);
                    make_binop_quad(&out, "<<", s->arg2, es, s->result);
                    fired = 1;
                }
            }
        }

        /* ── DIVISION ────────────────────────────────────────────────── */
        else if (strcmp(s->op, "/") == 0) {
            if (is_int_val(s->arg2, 1))
                { make_copy_quad(&out, s->result, s->arg1);  fired = 1; }
            else if (s->arg1[0] && strcmp(s->arg1, s->arg2) == 0)
                { make_copy_quad(&out, s->result, "1");       fired = 1; }
            else if (is_numeric(s->arg2)) {
                int e = pow2_exp((int)atof(s->arg2));
                if (e >= 1) {
                    char es[12]; sprintf(es, "%d", e);
                    make_binop_quad(&out, ">>", s->arg1, es, s->result);
                    fired = 1;
                }
            }
        }

        /* ── MODULO ──────────────────────────────────────────────────── */
        else if (strcmp(s->op, "%") == 0) {
            if (is_int_val(s->arg2, 1))
                { make_copy_quad(&out, s->result, "0");       fired = 1; }
        }

        /* ── EXPONENTIATION ──────────────────────────────────────────── */
        else if (strcmp(s->op, "^") == 0) {
            if (is_int_val(s->arg2, 0))
                { make_copy_quad(&out, s->result, "1");       fired = 1; }
            else if (is_int_val(s->arg2, 1))
                { make_copy_quad(&out, s->result, s->arg1);  fired = 1; }
        }

        /* ── LOGICAL NOT on literal ───────────────────────────────────── */
        else if (strcmp(s->op, "!") == 0 && s->arg2[0] == '\0') {
            if (is_int_val(s->arg1, 0))
                { make_copy_quad(&out, s->result, "1");       fired = 1; }
            else if (is_int_val(s->arg1, 1))
                { make_copy_quad(&out, s->result, "0");       fired = 1; }
        }

        /* ── Emit (simplified or original) ──────────────────────────── */
        OPT_IR[OPT_IR_idx++] = fired ? out : *s;
        if (fired) total++;
    }

    printf("[AlgSimpl] %d simplification(s) applied.  "
           "OPT_IR has %d quad(s).\n", total, OPT_IR_idx);
    return total;
}

/* ═══════════════════════════════════════════════════════════════════════════
   PASS 2 — COPY PROPAGATION
   ═══════════════════════════════════════════════════════════════════════════

   A "copy quad" has   op == "="   and   arg2 == "".   It means:
       result  ←  arg1

   Two-phase algorithm, both phases are O(n):

   Phase A — forward substitution
   ───────────────────────────────
   Maintain a live copy-table  { from → to }.
   For each quad left-to-right:
     1. If arg1 or arg2 is in the table, replace it with the canonical src.
     2. If this quad is itself a copy (result = src), add result→src.
     3. If this quad writes to any name, kill every table entry that
        mentions that name on either side (conservative kill).

   Phase B — dead-copy removal
   ────────────────────────────
   A copy  result = src  is dead when `result` is never used as arg1/arg2
   in any later quad.  Dead copies are removed by compacting OPT_IR into
   itself; OPT_IR_idx is updated accordingly.
   ─────────────────────────────────────────────────────────────────────── */

#define MAX_COPIES 256

typedef struct { char from[20]; char to[20]; int live; } CopyEntry;
static CopyEntry copy_table[MAX_COPIES];
static int       copy_count;

static void ct_clear(void) { copy_count = 0; memset(copy_table,0,sizeof(copy_table)); }

static void ct_add(const char *from, const char *to)
{
    for (int i = 0; i < copy_count; i++)
        if (copy_table[i].live && strcmp(copy_table[i].from, from) == 0)
            { strncpy(copy_table[i].to, to, 19); return; }
    if (copy_count < MAX_COPIES) {
        strncpy(copy_table[copy_count].from, from, 19);
        strncpy(copy_table[copy_count].to,   to,   19);
        copy_table[copy_count++].live = 1;
    }
}

static const char *ct_lookup(const char *name)
{
    for (int i = 0; i < copy_count; i++)
        if (copy_table[i].live && strcmp(copy_table[i].from, name) == 0)
            return copy_table[i].to;
    return name;
}

static void ct_kill(const char *name)
{
    for (int i = 0; i < copy_count; i++)
        if (copy_table[i].live &&
            (strcmp(copy_table[i].from, name) == 0 ||
             strcmp(copy_table[i].to,   name) == 0))
            copy_table[i].live = 0;
}

static int is_used_after(const char *name, int from)
{
    for (int i = from; i < OPT_IR_idx; i++)
        if (strcmp(OPT_IR[i].arg1, name) == 0 ||
            strcmp(OPT_IR[i].arg2, name) == 0) return 1;
    return 0;
}

/* Ops that are structural (not data-flow): skip substitution for these */
static int is_structural_op(const char *op)
{
    static const char *structural[] = {
        "label","goto","func","endfunc","entity","end_entity",
        "method","end_method","constr","end_constr","param", NULL
    };
    for (int i = 0; structural[i]; i++)
        if (strcmp(op, structural[i]) == 0) return 1;
    return 0;
}

int run_copy_propagation(void)
{
    int subs = 0, removed = 0;

    /* ── Phase A: forward substitution ─────────────────────────────── */
    ct_clear();
    for (int i = 0; i < OPT_IR_idx; i++) {
        Quad *q = &OPT_IR[i];
        if (is_structural_op(q->op)) continue;

        /* Substitute args */
        if (q->arg1[0]) {
            const char *sub = ct_lookup(q->arg1);
            if (strcmp(sub, q->arg1) != 0) { strncpy(q->arg1, sub, 19); subs++; }
        }
        if (q->arg2[0]) {
            const char *sub = ct_lookup(q->arg2);
            if (strcmp(sub, q->arg2) != 0) { strncpy(q->arg2, sub, 19); subs++; }
        }

        /* Record copy, then kill+re-add on write */
        int is_copy = (strcmp(q->op,"=") == 0 && q->arg2[0]=='\0'
                       && q->result[0] && q->arg1[0]);
        if (q->result[0]) {
            ct_kill(q->result);
            if (is_copy) ct_add(q->result, q->arg1);
        }
    }

    /* ── Phase B: dead-copy removal (compact OPT_IR into itself) ────── */
    int write = 0;
    for (int read = 0; read < OPT_IR_idx; read++) {
        Quad *q = &OPT_IR[read];
        int dead = (strcmp(q->op,"=") == 0 && q->arg2[0]=='\0'
                    && q->result[0] && !is_used_after(q->result, read+1));
        if (dead) { removed++; continue; }
        if (write != read) OPT_IR[write] = OPT_IR[read];
        write++;
    }
    OPT_IR_idx = write;

    printf("[CopyProp] %d substitution(s), %d dead copy(ies) removed.  "
           "OPT_IR has %d quad(s).\n", subs, removed, OPT_IR_idx);
    return subs + removed;
}

/* ═══════════════════════════════════════════════════════════════════════════
   PASS 3 — INDUCTION VARIABLE ELIMINATION
   ═══════════════════════════════════════════════════════════════════════════

   Loop structure in OPT_IR (emitted by for_stmt in parser.y)
   ────────────────────────────────────────────────────────────────────────
       label   ""  ""  L_begin         ← loop header
       ...     body quads
       ifFalse cond "" L_end           ← conditional exit
       ...     more body quads
       goto    ""  ""  L_begin         ← back-edge  ← loop identified here
       label   ""  ""  L_end           ← loop exit
   ────────────────────────────────────────────────────────────────────────

   Definitions
   ───────────
     BIV — Basic Induction Variable:
           i = i + c   or   i = i - c   (c a numeric constant)

     DIV — Derived Induction Variable:
           t = i * c   or   t = i + c   (i is a BIV, c is a constant)

   Transformation (per DIV, inserting into OPT_IR)
   ────────────────────────────────────────────────
     Before loop header   →  j = i div_op c        (init)
     After BIV update     →  j = j + (step * c)    (increment, folded)
     Original DIV quad    →  t = j                 (copy, for pass 2)

   Processing in reverse loop order so insertions for earlier (inner)
   loops do not corrupt stored indices for later (outer) ones.
   ─────────────────────────────────────────────────────────────────────── */

#define MAX_LOOPS 64
#define MAX_BIVS  16
#define MAX_DIVS  64

typedef struct {
    int  header;           /* index of  label "" "" L_begin  */
    int  footer;           /* index of  goto  "" "" L_begin  */
    int  exit_test;        /* index of  ifFalse cond "" L_end */
    char label_begin[20];
    char label_end[20];
} LoopInfo;

typedef struct {
    char   var[20];
    char   step_str[20];
    double step;
    int    update_idx;
    char   op[4];
} BIV;

typedef struct {
    char   result[20];
    char   biv_name[20];
    char   coeff_str[20];
    double coeff;
    int    quad_idx;
    char   div_op[4];
} DIV_entry;

static LoopInfo  g_loops[MAX_LOOPS];
static int       g_loop_count;
static BIV       g_bivs[MAX_LOOPS][MAX_BIVS];
static int       g_biv_count[MAX_LOOPS];
static DIV_entry g_divs[MAX_LOOPS][MAX_DIVS];
static int       g_div_count[MAX_LOOPS];
static int       g_ive_var_cnt = 0;

static void ive_new_var(char *buf) { sprintf(buf, "iv%d", g_ive_var_cnt++); }

int run_induction_variable_elimination(void)
{
    g_loop_count = 0;
    int total    = 0;

    /* ── Step 1: detect loops via back-edges ─────────────────────────── */
    for (int i = 0; i < OPT_IR_idx && g_loop_count < MAX_LOOPS; i++) {
        if (strcmp(OPT_IR[i].op, "goto") != 0) continue;
        const char *target = OPT_IR[i].result;

        /* Search for an earlier label with the same name */
        int hdr = -1;
        for (int j = 0; j < i; j++)
            if (strcmp(OPT_IR[j].op,"label")==0 &&
                strcmp(OPT_IR[j].result, target)==0) { hdr = j; break; }
        if (hdr < 0) continue;   /* forward jump — not a loop */

        LoopInfo *lp = &g_loops[g_loop_count];
        lp->header = hdr;
        lp->footer = i;
        strncpy(lp->label_begin, target, 19);
        lp->exit_test    = -1;
        lp->label_end[0] = '\0';
        g_biv_count[g_loop_count] = 0;
        g_div_count[g_loop_count] = 0;

        for (int j = hdr; j <= i; j++)
            if (strcmp(OPT_IR[j].op,"ifFalse")==0)
                { lp->exit_test = j; strncpy(lp->label_end, OPT_IR[j].result,19); break; }

        g_loop_count++;
    }

    if (g_loop_count == 0) {
        printf("[IVE] No loops detected.\n");
        return 0;
    }

    /* ── Steps 2-4: process loops in reverse order ───────────────────── */
    for (int li = g_loop_count - 1; li >= 0; li--) {
        LoopInfo *lp = &g_loops[li];
        int body_start = lp->header + 1;
        int body_end   = lp->footer - 1;
        if (body_start > body_end) continue;

        /* Step 2: collect BIVs  ( i = i ± c ) */
        int bc = 0;
        for (int i = body_start; i <= body_end && bc < MAX_BIVS; i++) {
            Quad *q = &OPT_IR[i];
            if ((strcmp(q->op,"+")==0 || strcmp(q->op,"-")==0) &&
                strcmp(q->arg1, q->result)==0 &&
                q->result[0] && is_numeric(q->arg2))
            {
                BIV *b = &g_bivs[li][bc++];
                strncpy(b->var,      q->result, 19);
                strncpy(b->step_str, q->arg2,   19);
                strncpy(b->op,       q->op,      3);
                b->step       = (strcmp(q->op,"-")==0) ? -atof(q->arg2) : atof(q->arg2);
                b->update_idx = i;
            }
        }
        g_biv_count[li] = bc;
        if (bc == 0) continue;

        /* Step 3: collect DIVs  ( t = BIV * c  or  t = BIV + c ) */
        int dc = 0;
        for (int i = body_start; i <= body_end && dc < MAX_DIVS; i++) {
            Quad *q = &OPT_IR[i];
            if (strcmp(q->op,"*")!=0 && strcmp(q->op,"+")!=0) continue;
            if (!q->result[0]) continue;

            for (int b = 0; b < bc; b++) {
                const char *bname = g_bivs[li][b].var;
                /* t = BIV op constant */
                if (strcmp(q->arg1,bname)==0 && is_numeric(q->arg2)) {
                    DIV_entry *d = &g_divs[li][dc++];
                    strncpy(d->result,    q->result, 19);
                    strncpy(d->biv_name,  bname,     19);
                    strncpy(d->coeff_str, q->arg2,   19);
                    d->coeff    = atof(q->arg2);
                    d->quad_idx = i;
                    strncpy(d->div_op, q->op, 3);
                    break;
                }
                /* t = constant op BIV  (commutative) */
                if (strcmp(q->arg2,bname)==0 && is_numeric(q->arg1)) {
                    DIV_entry *d = &g_divs[li][dc++];
                    strncpy(d->result,    q->result, 19);
                    strncpy(d->biv_name,  bname,     19);
                    strncpy(d->coeff_str, q->arg1,   19);
                    d->coeff    = atof(q->arg1);
                    d->quad_idx = i;
                    strncpy(d->div_op, q->op, 3);
                    break;
                }
            }
        }
        g_div_count[li] = dc;
        if (dc == 0) continue;

        /* Step 4: transform each DIV */
        for (int di = 0; di < dc; di++) {
            DIV_entry *dv = &g_divs[li][di];

            /* Find the BIV this DIV depends on */
            BIV *bv = NULL;
            for (int b = 0; b < bc; b++)
                if (strcmp(g_bivs[li][b].var, dv->biv_name)==0)
                    { bv = &g_bivs[li][b]; break; }
            if (!bv) continue;

            char j[20];
            ive_new_var(j);

            /* ── 4a: insert  j = BIV div_op coeff  BEFORE header ───── */
            int ins = lp->header;      /* slot opened before label quad   */
            if (!insert_opt_quad_at(ins)) continue;

            /* Adjust ALL stored indices >= ins across all loops */
            for (int x = 0; x < g_loop_count; x++) {
                if (g_loops[x].header   >= ins) g_loops[x].header++;
                if (g_loops[x].footer   >= ins) g_loops[x].footer++;
                if (g_loops[x].exit_test >= ins) g_loops[x].exit_test++;
            }
            for (int b = 0; b < bc; b++)
                if (g_bivs[li][b].update_idx >= ins) g_bivs[li][b].update_idx++;
            for (int dj = di; dj < dc; dj++)
                if (g_divs[li][dj].quad_idx >= ins) g_divs[li][dj].quad_idx++;
            /* refresh bv pointer after possible array shift */
            for (int b = 0; b < bc; b++)
                if (strcmp(g_bivs[li][b].var, dv->biv_name)==0)
                    { bv = &g_bivs[li][b]; break; }

            Quad *init_q = &OPT_IR[ins];
            strcpy(init_q->op,     dv->div_op);
            strcpy(init_q->arg1,   bv->var);
            strcpy(init_q->arg2,   dv->coeff_str);
            strcpy(init_q->result, j);

            /* ── 4b: insert  j = j + (step * coeff)  AFTER BIV update ─ */
            double inc_val = bv->step * dv->coeff;
            char   inc_str[24];
            if (inc_val == (long)inc_val) sprintf(inc_str, "%ld", (long)inc_val);
            else                          sprintf(inc_str, "%f",  inc_val);

            int inc_pos = bv->update_idx + 1;
            if (!insert_opt_quad_at(inc_pos)) continue;

            for (int x = 0; x < g_loop_count; x++) {
                if (g_loops[x].footer    >= inc_pos) g_loops[x].footer++;
                if (g_loops[x].exit_test >= inc_pos) g_loops[x].exit_test++;
            }
            for (int dj = di; dj < dc; dj++)
                if (g_divs[li][dj].quad_idx >= inc_pos) g_divs[li][dj].quad_idx++;

            Quad *inc_q = &OPT_IR[inc_pos];
            strcpy(inc_q->op,     "+");
            strcpy(inc_q->arg1,   j);
            strcpy(inc_q->arg2,   inc_str);
            strcpy(inc_q->result, j);

            /* ── 4c: replace original DIV quad with  t = j  (copy) ──── */
            make_copy_quad(&OPT_IR[dv->quad_idx], dv->result, j);

            total++;
        }
    }

    printf("[IVE] %d induction variable(s) eliminated.  "
           "OPT_IR has %d quad(s).\n", total, OPT_IR_idx);
    return total;
}


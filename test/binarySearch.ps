int _func binarySearch(int tgt){
	int 1seq arr = {1,2,3,4,5};
	int l = 0;
	int r = 4;

	for(;l<r;){
		int mid = (l+r)/2;
		if(arr[mid] == tgt){
			return mid;
		}
		else if(arr[mid] < tgt){
			l = mid+1;
		}
		else{
			r = mid-1;
		}
	}
	return -1;
}

int target = 1;
int res = binarySearch(target);
show(res);

int 1seq arr = {1, 2, 3, 4, 5};
int _func binarySearch(int tgt){
    int l = 0;
    int r = 4;
    int mid; 
    int search_target = tgt;  // Different name, declare before array
    
    for(;l < r||l==r;){
        mid = (l + r) / 2;
        if(arr[mid] == search_target){
            return mid;
        }
        if(arr[mid] < search_target){
            l = mid + 1;
        }
        else{
            r = mid - 1;
        }
    }
    return -1;
}


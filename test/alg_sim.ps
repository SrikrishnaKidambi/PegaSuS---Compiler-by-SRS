void _func test_algebraic() {

    int a;
    int b;
    int result;

    a = 5;
    b = 3;

    result = a + 0;
    show(result);

    result = 0 + a;
    show(result);

    result = a - 0;
    show(result);

    result = a - a;
    show(result);

    result = a * 0;
    show(result);

    result = 0 * a;
    show(result);

    result = a * 1;
    show(result);

    result = 1 * a;
    show(result);

    result = a * 2;
    show(result);

    result = a * 8;
    show(result);

    result = a / 1;
    show(result);

    result = a / a;
    show(result);

    result = a / 4;
    show(result);

    result = a % 1;
    show(result);

}

void _func main() {

    test_algebraic();

}


int _func add(int a, int b, int c, int d, int e, int f, int g, int h) {
    int p1 = a + b;
    int p2 = c + d;
    int p3 = e + f;
    int p4 = g + h;
    int p5 = p1 + p2;
    int p6 = p3 + p4;
    int p7 = p5 + p6;
    int p8 = p7 + a;
    int p9 = p8 + b;
    return p9;
}
int result = add(1, 2, 3, 4, 5, 6, 7, 8);
show(result);

Entity Point {

    public int x;
    public int y;

    Point() {
        this.x = 0;
        this.y = 0;
    }

    Point(int a) {
        this.x = a;
        this.y = 0;
    }

    Point(int a, int b) {
        this.x = a;
        this.y = b;
    }
}

Point p1 = new Point();
Point p2 = new Point(5);
Point p3 = new Point(3,4);
show(p1.x);
show(p1.y);
show(p2.x);
show(p2.y);
show(p3.x);
show(p3.y);

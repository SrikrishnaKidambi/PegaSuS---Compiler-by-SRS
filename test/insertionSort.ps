int 1seq arr = {5, 3, 8, 1, 2};
int n = 5;

void _func insertion_sort(){
    for(int i = 1; i < n; i = i + 1){
        int key = arr[i];
	int j = i - 1;
        for(; j > 0 || j==0; j = j - 1){
	    if(arr[j] < key || arr[j] == key){
		    break;
	    }
	    arr[j + 1] = arr[j];
        }
        arr[j + 1] = key;
    }
}

void _func main(){
    insertion_sort();
    for(int i = 0; i < n; i = i + 1){
        show(arr[i]);
    }
}

main();

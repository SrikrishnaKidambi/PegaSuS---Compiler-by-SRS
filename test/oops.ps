Entity Patient {
	private string name;
	public int fee;
	public int days;
	Patient(string name, int fee, int days){
		this.name=name;
		this.fee=fee;
		this.days=days;
	}
	public int _func total_fee(){
		int temp1 = this.fee;
		int temp2 = this.days;
		int temp = temp1* temp2;
		return temp;
	}
	public string _func getName(){
		return this.name;
	}
}

Patient P = new Patient("Saiman",200,5);
int result=P.total_fee();
show(result);
string res = P.getName();
show(res);

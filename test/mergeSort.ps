int n = 5;
int INF = 9999;

// Edge list: from, to, weight
int 1seq edges_from = {0, 0, 1, 1, 2, 2, 2, 3, 4};
int 1seq edges_to = {1, 2, 2, 3, 1, 3, 4, 4, 3};
int 1seq edges_weight = {10, 3, 1, 2, 4, 8, 2, 7, 9};
int num_edges = 9;

int 1seq dist[5];
bool 1seq visited[5];

void _func dijkstra(int src){
    int i;
    int count;
    int e;
    int minDist;
    int u;
    int v;
    int weight;

    for(i = 0; i < n; i = i + 1){
        dist[i] = INF;
        visited[i] = False;
    }
    dist[src] = 0;

    for(count = 0; count < n - 1; count = count + 1){
        minDist = INF;
        u = -1;
        for(v = 0; v < n; v = v + 1){
            if(visited[v] == False && dist[v] < minDist){
                minDist = dist[v];
                u = v;
            }
        }

        if(u == -1){
            count = n;
        } else {
            visited[u] = True;
            for(e = 0; e < num_edges; e = e + 1){
                if(edges_from[e] == u){
                    v = edges_to[e];
                    weight = edges_weight[e];
                    if(visited[v] == False && weight != 0 && dist[u] + weight < dist[v]){
                        dist[v] = dist[u] + weight;
                    }
                }
            }
        }
    }
}

void _func main(){
    int i;
    dijkstra(0);
    show("Shortest distances from node 0:");
    show("\n");
    for(i = 0; i < n; i = i + 1){
        show(dist[i]);
        show("\n");
    }
}

main();

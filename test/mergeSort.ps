        arr[k] = R[j];
        j = j + 1;
    }
}

void _func mergeSort(int l, int r){
    if(l < r){
        int m = l + (r - l) / 2;
        mergeSort(l, m);
        mergeSort(m + 1, r);
        merge(l, m, r);
    }
}

void _func main(){
    int i;
    mergeSort(0, n - 1);
    for(i = 0; i < n; i = i + 1){
        show(arr[i]);
        show("\n");

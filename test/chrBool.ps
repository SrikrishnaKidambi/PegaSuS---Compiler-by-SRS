// Simple bool and chr test
bool b1 = True;
bool b2 = False;
chr ch = 'X';

show(b1);      // Should print 1
show("\n");
show(b2);      // Should print 0
show("\n");
show(ch);      // Should print X
show("\n");

// Boolean operations
bool result = b1 && b2;
show(result);  // Should print 0
show("\n");

result = b1 || b2;
show(result);  // Should print 1
show("\n");

//Bellman Ford algorithm

// Number of nodes
int n = 5;
int INF = 9999;

// Edge list: from, to, weight
int 1seq edges_from = {0, 0, 1, 1, 2, 2, 2, 3, 4};
int 1seq edges_to = {1, 2, 2, 3, 1, 3, 4, 4, 3};
int 1seq edges_weight = {10, 3, 1, 2, 4, 8, 2, 7, 9};
int num_edges = 9;

int 1seq dist[5];

void _func bellmanFord(int src){
    int i;
    int e;
    
    for(i = 0; i < n; i = i + 1){
        dist[i] = INF;
    }
    dist[src] = 0;
    
    for(i = 0; i < n - 1; i = i + 1){
        for(e = 0; e < num_edges; e = e + 1){
            int u = edges_from[e];
            int v = edges_to[e];
            int w = edges_weight[e];
            if(!(dist[u] == INF)){
                if(dist[u] + w < dist[v]){
                    dist[v] = dist[u] + w;
                }
            }
        }
    }
}

void _func main(){
    int i;
    bellmanFord(0);
    show("Shortest distances from node 0:");
    show("\n");
    for(i = 0; i < n; i = i + 1){
        show(dist[i]);
        show("\n");
    }
}

main();

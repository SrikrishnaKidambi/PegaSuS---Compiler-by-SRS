void _func test_ive() {

    int i;
    int n;
    int offset;
    int stride;

    n = 10;

    for(i = 0; i < n; i = i + 1) {
        offset = i * 5;
        show(offset);
    }

    for(i = 0; i < n; i = i + 2) {
        offset = i * 6;
        show(offset);
    }

    for(i = 0; i < n; i = i + 1) {
        offset = i * 7;
        stride = i * 3;
        show(offset);
        show(stride);
    }

}

void _func main() {
    test_ive();
}

